# Copy this file to  .env  and fill in your key. Never commit .env itself
# (it's git-ignored) or a real key in this file.
# Get a free Gemini API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the model (defaults to gemini-3.6-flash, with automatic
# fallback to other models if that one is out of quota — see chatbot/llm.py).
# GEMINI_MODEL=gemini-3.6-flash

# --- Deploying on Streamlit Community Cloud? ---
# Don't use this file there. Instead set GEMINI_API_KEY (and optionally
# GEMINI_MODEL) in your app's Settings -> Secrets, in TOML format:
#   GEMINI_API_KEY = "your_gemini_api_key_here"
#   GEMINI_MODEL = "gemini-3.6-flash"
